# Credentials are read from the environment ONLY. The config loader refuses to
# start if it finds anything key-shaped in a YAML file.
#
# Copy to .env and fill in. .env is gitignored.

BINANCE_API_KEY=
BINANCE_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Dashboard auth. REQUIRED if you bind to anything but 127.0.0.1 --
# the server refuses to start otherwise.
TRIANGULUM_DASHBOARD_TOKEN=

# The live-trading triple lock. All three are required; this is one of them.
# TRIANGULUM_ARM_LIVE=I_ACCEPT_FULL_LOSS_OF_CAPITAL

# Optional alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
