__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime state -- never commit.
#
# ANCHORED to the repo root with a leading slash. A bare `data/` matches at
# every depth, which silently excluded the whole `vault/data/` package -- the
# series, cache, fetchers and fixtures the rest of the system is built on --
# from a commit that otherwise looked complete. Nothing warns you: `git status`
# is clean, the push succeeds, and the repository is simply broken for anyone
# who clones it.
/data/
!/data/.gitkeep
*.db
*.db-journal
*.ndjson
*.ndjson.gz

# Secrets -- never commit
.env
.env.*
!.env.example
*.pem
*.key
.triangulum-live-ack

.DS_Store

# Web console
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/tsconfig.tsbuildinfo
